// Prisma schema for the Memorial do Jornal portal

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Singleton row (id always 1) holding site-wide appearance settings.
model SiteSetting {
  id           Int      @id @default(1)
  backgroundColor String  @default("#f7f8fb")
  primaryColor   String   @default("#4f8ecb")
  accentColor    String   @default("#d9822b")
  secondaryColor String   @default("#A8E6CF")
  supportColor   String   @default("#AEDDF7")
  creditsText    String   @db.Text
  facebookUrl  String?
  instagramUrl String?
  xUrl         String?
  youtubeUrl   String?
  /// Faint background image behind the masthead (logo/name) row, shown on every page.
  mastheadImageUrl String?
  /// How many banners the sponsor strip (above the footer, every page) shows
  /// per page view: pinned banners always, then random ones up to this total.
  bannerSlots  Int      @default(8)
  /// Background AI transcription of pending pages (src/lib/ocr-revision/worker.ts).
  aiWorkerEnabled     Boolean @default(false)
  /// Pause between pages, in seconds, on top of the per-request Gemini throttle.
  aiWorkerIntervalSec Int     @default(20)
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

/// Singleton row (id always 1) holding the homepage's editorial content
/// (hero, "Memória Viva" video, "Por trás do Memorial" block). Kept separate
/// from SiteSetting because it's large, image-heavy, and only read by the
/// homepage, unlike SiteSetting which is consumed on every page.
model HomepageContent {
  id Int @id @default(1)

  heroImageUrl   String?
  heroHeadline   String  @default("Mais de um século registrando a nossa gente.") @db.Text
  heroSubtext    String? @db.Text
  heroCtaLabel   String  @default("EXPLORAR O ACERVO")
  heroCtaHref    String  @default("/edicoes")
  heroMockup1Url String?
  heroMockup2Url String?
  heroRibbonText String  @default("O PASSADO SEMPRE ATUAL")

  videoTitle        String  @default("MEMÓRIA VIVA")
  videoSubtitle      String? @db.Text
  videoEmbedUrl      String?
  videoThumbnailUrl  String?
  videoButtonLabel   String  @default("ASSISTA AO DOCUMENTÁRIO")

  behindTitle       String  @default("Por trás do Memorial")
  behindSubtext     String? @db.Text
  behindPhoto1Url   String?
  behindPhoto2Url   String?
  behindPhoto3Url   String?
  /// JSON [{label, href}] — each step is a button (see src/lib/behind-steps.ts).
  /// Older rows may still hold a plain comma-separated list of labels.
  behindLabels     String  @default("Digitalização,Pesquisa,Documentação,Audiovisual,Tecnologia") @db.Text
  behindButtonLabel String  @default("CONHEÇA O PROJETO")
  behindButtonHref  String  @default("/projetos")

  /// Photos for the 5 quick-nav cards (Décadas/Anos/Meses/Edições/Crônicas).
  /// Falls back to a plain icon when not set.
  navDecadasImageUrl  String?
  navAnosImageUrl     String?
  navMesesImageUrl    String?
  navEdicoesImageUrl  String?
  navCronicasImageUrl String?

  updatedAt DateTime @updatedAt

  @@map("homepage_content")
}

/// One slide of the homepage hero carousel. The hero* image/headline/CTA
/// columns on HomepageContent predate the carousel: the migration that added
/// this table copied them into the first slide, and they're no longer read.
/// The cover mockups and ribbon stay on HomepageContent (shared by all slides).
model HeroSlide {
  id        Int     @id @default(autoincrement())
  imageUrl  String?
  headline  String  @db.Text
  subtext   String? @db.Text
  ctaLabel  String?
  ctaHref   String?
  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("hero_slides")
}

model Page {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  body          String   @db.LongText
  coverImageUrl String?
  published     Boolean  @default(false)
  showInMenu    Boolean  @default(true)
  menuLabel     String?
  menuOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  images PageImage[]

  @@map("pages")
}

model PageImage {
  id      Int    @id @default(autoincrement())
  pageId  Int
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)

  @@map("page_images")
}

/// A sponsor banner shown in the strip above the footer on every page (see
/// src/lib/banners.ts for selection and counting).
model Sponsor {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String
  linkUrl   String?
  /// Pinned banners are always shown, first, sorted by `order`; the rest are
  /// drawn at random for each page view to fill SiteSetting.bannerSlots.
  pinned    Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  /// Optional run window; null = no bound.
  startsAt  DateTime?
  endsAt    DateTime?
  /// Stop showing after this many appearances; null = unlimited.
  maxAppearances Int?
  /// Lifetime counters (per-day breakdown in SponsorDailyStat):
  /// appearances = included in a page's strip; views = the strip was actually
  /// on screen; clicks = followed via /api/banners/[id]/click.
  appearances Int    @default(0)
  views       Int    @default(0)
  clicks      Int    @default(0)
  createdAt DateTime @default(now())
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt DateTime?

  dailyStats SponsorDailyStat[]

  @@map("sponsors")
}

model SponsorDailyStat {
  sponsorId   Int
  sponsor     Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  appearances Int      @default(0)
  views       Int      @default(0)
  clicks      Int      @default(0)

  @@id([sponsorId, date])
  @@index([date])
  @@map("sponsor_daily_stats")
}

model Chronicle {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  excerpt       String?  @db.Text
  body          String   @db.LongText
  coverImageUrl String?
  authorName    String?
  publishedAt   DateTime @default(now())
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  @@map("chronicles")
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  role      String?
  bio       String   @db.LongText
  photoUrl  String?
  bornYear  Int?
  diedYear  Int?
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt DateTime?

  @@map("characters")
}

model GalleryAlbum {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  description   String?  @db.Text
  coverImageUrl String?
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  photos GalleryPhoto[]

  @@map("gallery_albums")
}

model GalleryPhoto {
  id      Int          @id @default(autoincrement())
  albumId Int
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url     String
  caption String?
  order   Int          @default(0)

  captionSuggestions PhotoCaptionSuggestion[]

  @@map("gallery_photos")
}

/// Visitor-submitted photo identifications ("who is this?"), held for admin
/// review before they can overwrite a photo's public caption.
model PhotoCaptionSuggestion {
  id            Int          @id @default(autoincrement())
  photoId       Int
  photo         GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  suggestion    String       @db.Text
  submitterName String?
  /// "pending" | "approved" | "rejected"
  status        String       @default("pending")
  createdAt     DateTime     @default(now())

  @@index([photoId])
  @@index([status])
  @@map("photo_caption_suggestions")
}

model TimelineMilestone {
  id          Int      @id @default(autoincrement())
  year        Int
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt   DateTime?

  @@map("timeline_milestones")
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  summary       String?  @db.Text
  body          String   @db.LongText
  coverImageUrl String?
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  @@map("projects")
}

/// Submissions from the public "Fale Conosco" contact form.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  /// Best-effort flag: whether the notification e-mail was sent successfully.
  /// Not authoritative — the DB row is always the source of truth.
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model AdminUser {
  id              Int      @id @default(autoincrement())
  name            String
  username        String   @unique
  email           String   @unique
  passwordHash    String
  createdAt       DateTime @default(now())

  /// TOTP secret, encrypted at rest with SETTINGS_ENCRYPTION_KEY (see src/lib/mfa.ts). Null while MFA isn't enabled.
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?
  /// JSON array of sha256-hashed one-time backup codes.
  mfaBackupCodes  String?  @db.Text

  resetTokens PasswordResetToken[]

  @@map("admin_users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

/// The publication itself (logo, name). Kept as a table in case more than
/// one masthead is ever hosted on the same portal.
model Newspaper {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  logoUrl   String?
  tagline   String?
  createdAt DateTime @default(now())

  decades Decade[]

  @@map("newspapers")
}

model Decade {
  id          Int    @id @default(autoincrement())
  /// e.g. 2020 for the "decade of 2020" bucket
  startYear   Int
  label       String
  newspaperId Int
  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)

  years Year[]

  @@unique([newspaperId, startYear])
  @@map("decades")
}

model Year {
  id       Int    @id @default(autoincrement())
  year     Int
  decadeId Int
  decade   Decade @relation(fields: [decadeId], references: [id], onDelete: Cascade)

  months Month[]

  @@unique([decadeId, year])
  @@map("years")
}

model Month {
  id     Int    @id @default(autoincrement())
  /// 1-12
  month  Int
  yearId Int
  year   Year   @relation(fields: [yearId], references: [id], onDelete: Cascade)

  editions Edition[]

  @@unique([yearId, month])
  @@map("months")
}

/// One page of an edition's PDF with its text (embedded text layer, or OCR
/// for scanned pages). Searched through Meilisearch when configured, with
/// this table's FULLTEXT index as the fallback — Meilisearch can always be
/// rebuilt from here.
model EditionPage {
  editionId Int
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  /// 1-based page number within the PDF
  page      Int
  /// Original text (embedded text layer or OCR) — never overwritten by the AI revision
  text      String   @db.MediumText
  /// True when the text came from OCR rather than the PDF's own text layer
  ocr       Boolean  @default(false)
  /// AI transcription read from the page image (see src/lib/ocr-revision):
  /// "### Título\ntexto…" articles, old spelling kept, [ilegível]/[?] marks.
  revisedText  String?   @db.MediumText
  revisedModel String?
  revisedAt    DateTime?
  /// Last failure while revising this page (cleared on success)
  revisionError String?  @db.Text
  /// Set when a person checked (and possibly corrected) revisedText in the
  /// admin. Verified pages are the gold set used to measure the AI models, and
  /// "redo AI" never overwrites them.
  verifiedAt DateTime?
  verifiedBy String?
  /// Structured extraction (articles, people, places) done from revisedText;
  /// cleared whenever the text changes so it is redone.
  entitiesAt    DateTime?
  entitiesError String?  @db.Text
  updatedAt DateTime @updatedAt

  @@id([editionId, page])
  @@index([revisedAt])
  @@fulltext([text, revisedText])
  @@index([verifiedAt])
  @@map("edition_pages")
}

/// Every text a page's transcription has had — each AI run and each human
/// edit — so corrections can be reviewed, restored, and compared (the first AI
/// version vs. the human-verified one gives the model's error rate).
/// Linked to the edition, not the page row: re-extracting a PDF recreates the
/// page rows, and the history must survive that.
model PageTextVersion {
  id        Int      @id @default(autoincrement())
  editionId Int
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  page      Int
  text      String   @db.MediumText
  /// "ai" | "human"
  source    String   @db.VarChar(10)
  /// AI model(s) that produced it (source = "ai")
  model     String?
  /// Admin username (source = "human")
  author    String?
  createdAt DateTime @default(now())

  @@index([editionId, page, createdAt])
  @@map("page_text_versions")
}

/// A visitor's reading of one "[ilegível]" in a page's AI transcription,
/// held for admin review (see src/lib/transcription-suggestions). The marker
/// is located by its order on the page plus the text around it, snapshotted
/// here — so approving after the transcription changed can tell it moved.
model TranscriptionSuggestion {
  id            Int      @id @default(autoincrement())
  editionId     Int
  edition       Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  page          Int
  /// 0-based: which "[ilegível]" of the page, in text order
  occurrence    Int
  /// Transcription text right before/after the marker when it was suggested
  contextBefore String   @db.VarChar(200)
  contextAfter  String   @db.VarChar(200)
  suggestion    String   @db.VarChar(200)
  submitterName String?  @db.VarChar(100)
  /// "pending" | "approved" | "rejected"
  status        String   @default("pending") @db.VarChar(10)
  /// Admin username who approved/rejected
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([editionId, page])
  @@map("transcription_suggestions")
}

/// Semantic-search vectors of a page (see src/lib/search/embeddings.ts): the
/// page's search text split into passages, one vector each. Kept here, not
/// only in Meilisearch, so "Reenviar ao Meilisearch" never has to pay the
/// embedding API again. Linked to the edition, not the page row: re-extracting
/// a PDF recreates the page rows, and an unchanged text (same textHash) is
/// then reused instead of re-embedded.
model PageEmbedding {
  editionId  Int
  edition    Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  page       Int
  /// sha256 of the text that was embedded — a different hash means redo
  textHash   String   @db.Char(64)
  model      String   @db.VarChar(64)
  /// [start, end) character offsets of each passage in the embedded text
  chunks     Json
  /// Float32 little-endian, chunks.length × dimensions (empty when error is set)
  vectors    Bytes    @db.MediumBlob
  /// Permanent failure for this text (bad input); cleared by a new text
  error      String?  @db.Text
  embeddedAt DateTime

  @@id([editionId, page])
  @@index([embeddedAt])
  @@map("page_embeddings")
}

model Edition {
  id            Int      @id @default(autoincrement())
  title         String
  /// Sequential edition number within the newspaper's whole run
  editionNumber Int?
  publishedAt   DateTime
  /// Relative path under the private storage directory (not web-exposed directly)
  pdfPath       String
  /// Cover/thumbnail image generated from the PDF's first page
  thumbnailPath String?
  fileSizeBytes Int?
  pageCount     Int?
  monthId       Int
  month         Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  events AnalyticsEvent[]
  /// Text of each PDF page — the source of truth for full-text search
  /// (see src/lib/search). Filled on upload and by the admin "Indexar busca".
  pages  EditionPage[]
  textVersions PageTextVersion[]
  embeddings   PageEmbedding[]
  transcriptionSuggestions TranscriptionSuggestion[]
  articles     Article[]

  @@index([publishedAt])
  @@map("editions")
}

/// A navigable menu slot (e.g. "principal" for the header, "rodape" for the
/// footer). Rows are created lazily by the admin UI on first visit to that
/// slot, not seeded up front.
model Menu {
  id   Int    @id @default(autoincrement())
  key  String @unique
  name String

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id     Int  @id @default(autoincrement())
  menuId Int
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  /// Self-FK; null means top-level. The admin UI only surfaces one level of
  /// nesting (parent -> children), but the schema allows deeper trees.
  parentId Int?
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemChildren")

  label      String
  url        String
  sortOrder  Int      @default(0)
  openNewTab Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([menuId])
  @@index([parentId])
  @@map("menu_items")
}

enum AnalyticsEventType {
  EDITION_VIEW
  EDITION_DOWNLOAD
  SITE_VISIT
}

model AnalyticsEvent {
  id        Int                @id @default(autoincrement())
  type      AnalyticsEventType
  editionId Int?
  edition   Edition?           @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([editionId])
  @@map("analytics_events")
}

/// One newspaper item (news, note, ad…) found on a page by the structured
/// extraction (src/lib/entities). Recreated whenever the page text changes.
model Article {
  id        Int      @id @default(autoincrement())
  editionId Int
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  page      Int
  /// Order on the page (0-based)
  position  Int
  title     String   @db.VarChar(500)
  /// nascimento, casamento, obito, viagem, anuncio, noticia… (see ARTICLE_KINDS)
  kind      String   @db.VarChar(20)
  /// One sentence in modern Portuguese, written by the model
  summary   String   @db.Text
  model     String?
  createdAt DateTime @default(now())

  mentions EntityMention[]

  @@index([editionId, page])
  @@index([kind])
  @@map("articles")
}

/// A person or place, grouped across the archive by a spelling-folded key
/// ("Piumhy" = "Piumhi", "José Motta" = "José Mota").
model Entity {
  id           Int       @id @default(autoincrement())
  /// "person" | "place"
  kind         String    @db.VarChar(10)
  name         String    @db.VarChar(255)
  key          String    @db.VarChar(255)
  slug         String    @db.VarChar(255)
  /// Public mentions only (sensitive article kinds are left out, see PRIVATE_KINDS)
  mentionCount Int       @default(0)
  firstDate    DateTime?
  lastDate     DateTime?
  /// Hidden by an admin (LGPD request): no public page, name masked elsewhere.
  /// Survives re-extraction — the row is kept even with no mentions.
  hidden       Boolean   @default(false)
  hiddenAt     DateTime?
  /// Who asked and when, how the request arrived
  hiddenNote   String?   @db.Text

  mentions EntityMention[]

  @@unique([kind, key])
  @@unique([kind, slug])
  @@index([kind, mentionCount])
  @@map("entities")
}

model EntityMention {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entityId  Int
  entity    Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  /// As printed ("José Motta")
  surface   String  @db.VarChar(255)
  /// "sr.", "d.", "dr.", "cap."…
  honorific String? @db.VarChar(30)
  /// Short role in the item: "noiva", "falecido", "aniversariante"…
  role      String? @db.VarChar(100)

  @@index([entityId])
  @@index([articleId])
  @@map("entity_mentions")
}

/// An article kind an admin chose to hide from the public site (on top of the
/// fixed LGPD kinds in PRIVATE_KINDS, which can't be un-hidden). Presence of a
/// row = hidden. The transcription/PDF and full-text search are untouched —
/// only /materias and the mentions shown on person/place pages are filtered.
model HiddenArticleKind {
  kind     String   @id @db.VarChar(20)
  hiddenAt DateTime @default(now())

  @@map("hidden_article_kinds")
}
