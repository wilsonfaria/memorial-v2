// Prisma schema for the Memorial do Jornal portal

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Singleton row (id always 1) holding site-wide appearance settings.
model SiteSetting {
  id           Int      @id @default(1)
  backgroundColor String  @default("#f7f8fb")
  primaryColor   String   @default("#4f8ecb")
  accentColor    String   @default("#d9822b")
  secondaryColor String   @default("#A8E6CF")
  supportColor   String   @default("#AEDDF7")
  creditsText    String   @db.Text
  facebookUrl  String?
  instagramUrl String?
  xUrl         String?
  youtubeUrl   String?
  /// Faint background image behind the masthead (logo/name) row, shown on every page.
  mastheadImageUrl String?
  /// How many banners the sponsor strip (above the footer, every page) shows
  /// per page view: pinned banners always, then random ones up to this total.
  bannerSlots  Int      @default(8)
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

/// Singleton row (id always 1) holding the homepage's editorial content
/// (hero, "Memória Viva" video, "Por trás do Memorial" block). Kept separate
/// from SiteSetting because it's large, image-heavy, and only read by the
/// homepage, unlike SiteSetting which is consumed on every page.
model HomepageContent {
  id Int @id @default(1)

  heroImageUrl   String?
  heroHeadline   String  @default("Mais de um século registrando a nossa gente.") @db.Text
  heroSubtext    String? @db.Text
  heroCtaLabel   String  @default("EXPLORAR O ACERVO")
  heroCtaHref    String  @default("/edicoes")
  heroMockup1Url String?
  heroMockup2Url String?
  heroRibbonText String  @default("O PASSADO SEMPRE ATUAL")

  videoTitle        String  @default("MEMÓRIA VIVA")
  videoSubtitle      String? @db.Text
  videoEmbedUrl      String?
  videoThumbnailUrl  String?
  videoButtonLabel   String  @default("ASSISTA AO DOCUMENTÁRIO")

  behindTitle       String  @default("Por trás do Memorial")
  behindSubtext     String? @db.Text
  behindPhoto1Url   String?
  behindPhoto2Url   String?
  behindPhoto3Url   String?
  /// JSON [{label, href}] — each step is a button (see src/lib/behind-steps.ts).
  /// Older rows may still hold a plain comma-separated list of labels.
  behindLabels     String  @default("Digitalização,Pesquisa,Documentação,Audiovisual,Tecnologia") @db.Text
  behindButtonLabel String  @default("CONHEÇA O PROJETO")
  behindButtonHref  String  @default("/projetos")

  /// Photos for the 5 quick-nav cards (Décadas/Anos/Meses/Edições/Crônicas).
  /// Falls back to a plain icon when not set.
  navDecadasImageUrl  String?
  navAnosImageUrl     String?
  navMesesImageUrl    String?
  navEdicoesImageUrl  String?
  navCronicasImageUrl String?

  updatedAt DateTime @updatedAt

  @@map("homepage_content")
}

/// One slide of the homepage hero carousel. The hero* image/headline/CTA
/// columns on HomepageContent predate the carousel: the migration that added
/// this table copied them into the first slide, and they're no longer read.
/// The cover mockups and ribbon stay on HomepageContent (shared by all slides).
model HeroSlide {
  id        Int     @id @default(autoincrement())
  imageUrl  String?
  headline  String  @db.Text
  subtext   String? @db.Text
  ctaLabel  String?
  ctaHref   String?
  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("hero_slides")
}

model Page {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  body          String   @db.LongText
  coverImageUrl String?
  published     Boolean  @default(false)
  showInMenu    Boolean  @default(true)
  menuLabel     String?
  menuOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  images PageImage[]

  @@map("pages")
}

model PageImage {
  id      Int    @id @default(autoincrement())
  pageId  Int
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)

  @@map("page_images")
}

/// A sponsor banner shown in the strip above the footer on every page (see
/// src/lib/banners.ts for selection and counting).
model Sponsor {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String
  linkUrl   String?
  /// Pinned banners are always shown, first, sorted by `order`; the rest are
  /// drawn at random for each page view to fill SiteSetting.bannerSlots.
  pinned    Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  /// Optional run window; null = no bound.
  startsAt  DateTime?
  endsAt    DateTime?
  /// Stop showing after this many appearances; null = unlimited.
  maxAppearances Int?
  /// Lifetime counters (per-day breakdown in SponsorDailyStat):
  /// appearances = included in a page's strip; views = the strip was actually
  /// on screen; clicks = followed via /api/banners/[id]/click.
  appearances Int    @default(0)
  views       Int    @default(0)
  clicks      Int    @default(0)
  createdAt DateTime @default(now())
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt DateTime?

  dailyStats SponsorDailyStat[]

  @@map("sponsors")
}

model SponsorDailyStat {
  sponsorId   Int
  sponsor     Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  appearances Int      @default(0)
  views       Int      @default(0)
  clicks      Int      @default(0)

  @@id([sponsorId, date])
  @@index([date])
  @@map("sponsor_daily_stats")
}

model Chronicle {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  excerpt       String?  @db.Text
  body          String   @db.LongText
  coverImageUrl String?
  authorName    String?
  publishedAt   DateTime @default(now())
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  @@map("chronicles")
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  role      String?
  bio       String   @db.LongText
  photoUrl  String?
  bornYear  Int?
  diedYear  Int?
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt DateTime?

  @@map("characters")
}

model GalleryAlbum {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  description   String?  @db.Text
  coverImageUrl String?
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  photos GalleryPhoto[]

  @@map("gallery_albums")
}

model GalleryPhoto {
  id      Int          @id @default(autoincrement())
  albumId Int
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url     String
  caption String?
  order   Int          @default(0)

  captionSuggestions PhotoCaptionSuggestion[]

  @@map("gallery_photos")
}

/// Visitor-submitted photo identifications ("who is this?"), held for admin
/// review before they can overwrite a photo's public caption.
model PhotoCaptionSuggestion {
  id            Int          @id @default(autoincrement())
  photoId       Int
  photo         GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  suggestion    String       @db.Text
  submitterName String?
  /// "pending" | "approved" | "rejected"
  status        String       @default("pending")
  createdAt     DateTime     @default(now())

  @@index([photoId])
  @@index([status])
  @@map("photo_caption_suggestions")
}

model TimelineMilestone {
  id          Int      @id @default(autoincrement())
  year        Int
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt   DateTime?

  @@map("timeline_milestones")
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  summary       String?  @db.Text
  body          String   @db.LongText
  coverImageUrl String?
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  @@map("projects")
}

/// Submissions from the public "Fale Conosco" contact form.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  /// Best-effort flag: whether the notification e-mail was sent successfully.
  /// Not authoritative — the DB row is always the source of truth.
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model AdminUser {
  id              Int      @id @default(autoincrement())
  name            String
  username        String   @unique
  email           String   @unique
  passwordHash    String
  createdAt       DateTime @default(now())

  /// TOTP secret, encrypted at rest with SETTINGS_ENCRYPTION_KEY (see src/lib/mfa.ts). Null while MFA isn't enabled.
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?
  /// JSON array of sha256-hashed one-time backup codes.
  mfaBackupCodes  String?  @db.Text

  resetTokens PasswordResetToken[]

  @@map("admin_users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

/// The publication itself (logo, name). Kept as a table in case more than
/// one masthead is ever hosted on the same portal.
model Newspaper {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  logoUrl   String?
  tagline   String?
  createdAt DateTime @default(now())

  decades Decade[]

  @@map("newspapers")
}

model Decade {
  id          Int    @id @default(autoincrement())
  /// e.g. 2020 for the "decade of 2020" bucket
  startYear   Int
  label       String
  newspaperId Int
  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)

  years Year[]

  @@unique([newspaperId, startYear])
  @@map("decades")
}

model Year {
  id       Int    @id @default(autoincrement())
  year     Int
  decadeId Int
  decade   Decade @relation(fields: [decadeId], references: [id], onDelete: Cascade)

  months Month[]

  @@unique([decadeId, year])
  @@map("years")
}

model Month {
  id     Int    @id @default(autoincrement())
  /// 1-12
  month  Int
  yearId Int
  year   Year   @relation(fields: [yearId], references: [id], onDelete: Cascade)

  editions Edition[]

  @@unique([yearId, month])
  @@map("months")
}

model Edition {
  id            Int      @id @default(autoincrement())
  title         String
  /// Sequential edition number within the newspaper's whole run
  editionNumber Int?
  publishedAt   DateTime
  /// Relative path under the private storage directory (not web-exposed directly)
  pdfPath       String
  /// Cover/thumbnail image generated from the PDF's first page
  thumbnailPath String?
  fileSizeBytes Int?
  pageCount     Int?
  monthId       Int
  month         Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)

  /// Text layer / OCR output, populated on demand from the admin edition list — powers full-text search on /edicoes.
  extractedText String?  @db.LongText
  createdAt     DateTime @default(now())
  /// Soft-delete: set when moved to the admin trash, cleared on restore. Null = live.
  deletedAt     DateTime?

  events AnalyticsEvent[]

  @@index([publishedAt])
  @@map("editions")
}

/// A navigable menu slot (e.g. "principal" for the header, "rodape" for the
/// footer). Rows are created lazily by the admin UI on first visit to that
/// slot, not seeded up front.
model Menu {
  id   Int    @id @default(autoincrement())
  key  String @unique
  name String

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id     Int  @id @default(autoincrement())
  menuId Int
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  /// Self-FK; null means top-level. The admin UI only surfaces one level of
  /// nesting (parent -> children), but the schema allows deeper trees.
  parentId Int?
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemChildren")

  label      String
  url        String
  sortOrder  Int      @default(0)
  openNewTab Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([menuId])
  @@index([parentId])
  @@map("menu_items")
}

enum AnalyticsEventType {
  EDITION_VIEW
  EDITION_DOWNLOAD
  SITE_VISIT
}

model AnalyticsEvent {
  id        Int                @id @default(autoincrement())
  type      AnalyticsEventType
  editionId Int?
  edition   Edition?           @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([editionId])
  @@map("analytics_events")
}
